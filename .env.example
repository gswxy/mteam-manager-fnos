# 馒头管家环境变量示例（开发用途）
# 复制为 .env 或直接导出；生产环境（FPK 内）由生命周期脚本自动注入 TRIM_* 变量。
# 注意：绝不提交真实账号信息。M-Team API Key 与 NAS 凭据应在应用「设置」页面配置，
# 加密存储于数据库，而非环境变量。

# 数据目录（SQLite、种子文件、密钥）
MTM_DATA_DIR=./data

# 开发模式：跳过 fnOS 网关可信头校验，监听 TCP 端口
MTM_DEV=1
MTM_PORT=8686

# 前端静态资源目录（生产由脚本注入）
# MTM_STATIC_DIR=../frontend/dist

# fnOS 统一网关 Unix Socket（生产由 TRIM_APPDEST 推导）
# MTM_UNIX_SOCKET=/var/apps/mteam-manager/target/app.sock

# M-Team 默认 API 地址（账号设置中可按账号覆盖）
# MTM_MTEAM_API=https://api.m-team.cc

# fnOS 下载中心 WebSocket 地址（应用运行于 NAS 内，默认本机）
# MTM_FNOS_WS=ws://127.0.0.1:5666/websocket
